+import { useEffect, useRef, useState } from 'react';
+import { Layers, Loader2, Trash2, X } from 'lucide-react';
+import type { Screenshot } from '@/types';
+import { formatBytes, formatTime } from '@/lib/image';
+
+export function DuplicatesReview({
+  screenshots,
+  onClose,
+  onDelete,
+  onKeepAll,
+}: {
+  /** Newest first. Must have at least 2 entries. */
+  screenshots: Screenshot[];
+  onClose: () => void;
+  onDelete: (ids: string[]) => Promise<void>;
+  onKeepAll: () => Promise<void>;
+}) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  const [urls, setUrls] = useState<Record<string, string>>({});
+  // Default: keep the newest, mark the rest for deletion. The user can change any of it before confirming.
+  const [toDelete, setToDelete] = useState<Set<string>>(() => new Set(screenshots.slice(1).map((s) => s.id)));
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    const element = dialog.current!;
+    element.showModal();
+    return () => { if (element.open) element.close(); };
+  }, []);
+
+  useEffect(() => {
+    const next: Record<string, string> = {};
+    for (const s of screenshots) next[s.id] = URL.createObjectURL(s.blob);
+    setUrls(next);
+    return () => { Object.values(next).forEach((url) => URL.revokeObjectURL(url)); };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [screenshots.map((s) => s.id).join(',')]);
+
+  function toggle(id: string) {
+    setToDelete((prev) => {
+      const next = new Set(prev);
+      if (next.has(id)) next.delete(id);
+      else next.add(id);
+      return next;
+    });
+  }
+
+  const keepCount = screenshots.length - toDelete.size;
+
+  async function confirmDelete() {
+    if (busy || toDelete.size === 0 || keepCount < 1) return;
+    setBusy(true);
+    setError('');
+    try {
+      await onDelete([...toDelete]);
+      onClose();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function keepAll() {
+    if (busy) return;
+    setBusy(true);
+    setError('');
+    try {
+      await onKeepAll();
+      onClose();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <dialog
+      ref={dialog}
+      aria-labelledby="duplicates-heading"
+      className="calendar-dialog"
+      onCancel={(e) => { if (busy) e.preventDefault(); else onClose(); }}
+    >
+      <div className="review-heading">
+        <div>
+          <p className="panel-eyebrow mb-1">SUGGESTED ACTION</p>
+          <h2 id="duplicates-heading" className="text-xl font-semibold text-brand-950 flex items-center gap-2">
+            <Layers size={19} />
+            Review possible duplicates
+          </h2>
+        </div>
+        <button disabled={busy} className="icon-button" aria-label="Close duplicates review" onClick={onClose}>
+          <X size={19} />
+        </button>
+      </div>
+      <div className="p-5">
+        <p className="text-sm text-stone-600 mb-4">
+          These {screenshots.length} screenshots look visually alike (matched by image similarity, not by their text). Nothing is
+          deleted automatically — the newest is kept by default; adjust the selection and confirm.
+        </p>
+        {error && <p role="alert" className="rounded-lg bg-red-50 text-red-700 p-3 text-sm mb-4">{error}</p>}
+        <div className="grid grid-cols-2 sm:grid-cols-3 gap-4 max-h-[55vh] overflow-y-auto scrollbar-thin pr-1">
+          {screenshots.map((s, i) => {
+            const marked = toDelete.has(s.id);
+            return (
+              <div
+                key={s.id}
+                className={`relative rounded-xl border-2 overflow-hidden transition-colors ${marked ? 'border-red-300' : 'border-brand-200'}`}
+              >
+                <button
+                  type="button"
+                  onClick={() => toggle(s.id)}
+                  className="block w-full text-left relative"
+                  aria-pressed={marked}
+                  aria-label={`${marked ? 'Unmark' : 'Mark'} ${s.name} for deletion`}
+                >
+                  <div className="aspect-[4/3] bg-stone-100">
+                    {urls[s.id] && <img src={urls[s.id]} alt={s.name} className="w-full h-full object-cover" />}
+                  </div>
+                  {marked && (
+                    <div className="absolute inset-0 bg-red-900/30 flex items-center justify-center pointer-events-none">
+                      <Trash2 className="w-6 h-6 text-white" />
+                    </div>
+                  )}
+                </button>
+                <div className="p-2 bg-white">
+                  <p className="text-xs font-medium text-stone-700 truncate" title={s.name}>{s.name}</p>
+                  <p className="text-[11px] text-stone-400">
+                    {formatBytes(s.size)} · {formatTime(s.createdAt)}
+                    {i === 0 ? ' · Newest' : ''}
+                  </p>
+                  <label className="flex items-center gap-2 mt-1.5 text-xs text-stone-600">
+                    <input type="checkbox" checked={marked} onChange={() => toggle(s.id)} />
+                    Delete this one
+                  </label>
+                </div>
+              </div>
+            );
+          })}
+        </div>
+        {keepCount < 1 && (
+          <p className="text-xs text-red-600 mt-3">Keep at least one screenshot from this group.</p>
+        )}
+        <div className="flex flex-wrap justify-end gap-3 mt-6">
+          <button type="button" disabled={busy} onClick={keepAll} className="px-4 py-2.5 text-sm font-medium text-stone-600 rounded-lg hover:bg-stone-100">
+            Not duplicates — keep all
+          </button>
+          <button
+            type="button"
+            disabled={busy || toDelete.size === 0 || keepCount < 1}
+            onClick={confirmDelete}
+            className="small-primary px-4 py-2.5 text-sm !bg-red-600 hover:!bg-red-700"
+          >
+            {busy ? <Loader2 size={16} className="animate-spin" /> : <Trash2 size={16} />}
+            Delete {toDelete.size} {toDelete.size === 1 ? 'screenshot' : 'screenshots'}
+          </button>
+        </div>
+      </div>
+    </dialog>
+  );
+}
