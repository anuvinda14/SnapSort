diff --git a/tests/duplicates.test.mjs b/tests/duplicates.test.mjs
new file mode 100644
index 0000000..dd8522c
--- /dev/null
+++ b/tests/duplicates.test.mjs
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { hammingDistance } from '../src/lib/phash.ts';
+import { findDuplicateGroups, DEFAULT_DUPLICATE_THRESHOLD } from '../src/lib/duplicates.ts';
+
+const shot = (id, phash, extra = {}) => ({
+  id,
+  name: `${id}.png`,
+  status: 'ready',
+  createdAt: 0,
+  size: 1000,
+  phash,
+  ...extra,
+});
+
+test('hammingDistance counts differing bits, and treats mismatched lengths as maximally different', () => {
+  assert.equal(hammingDistance('0000000000000000', '0000000000000000'), 0);
+  assert.equal(hammingDistance('0000000000000000', 'f000000000000000'), 4);
+  assert.equal(hammingDistance('ffffffffffffffff', '0000000000000000'), 64);
+  assert.equal(hammingDistance('00', '000'), Number.MAX_SAFE_INTEGER);
+});
+
+test('near-identical hashes are grouped; unrelated hashes are not', () => {
+  const groups = findDuplicateGroups([
+    shot('a', '0000000000000000', { createdAt: 3 }),
+    shot('b', '0000000000000001', { createdAt: 2 }), // 1 bit off -> same group as a
+    shot('c', 'ffffffffffffffff', { createdAt: 1 }), // maximally different -> its own group (size 1, dropped)
+  ]);
+  assert.equal(groups.length, 1);
+  assert.deepEqual(groups[0].screenshotIds, ['a', 'b']); // newest first
+});
+
+test('transitive chains merge into one group even if the endpoints are past the threshold apart', () => {
+  // a~b close, b~c close, but a~c alone would be too far apart
+  const groups = findDuplicateGroups([
+    shot('a', '0000000000000000'),
+    shot('b', '0000000000000007'), // 3 bits from a
+    shot('c', '000000000000003f'), // 3 bits from b, 6 bits from a
+  ], 3);
+  assert.equal(groups.length, 1);
+  assert.equal(groups[0].screenshotIds.length, 3);
+});
+
+test('items without a valid hash (missing, or the "error" sentinel) are ignored', () => {
+  const groups = findDuplicateGroups([
+    shot('a', '0000000000000000'),
+    shot('b', undefined),
+    shot('c', 'error'),
+  ]);
+  assert.equal(groups.length, 0);
+});
+
+test('groups only form above 2 members and use a stable, set-based id', () => {
+  const items = [shot('a', '0000000000000000'), shot('b', '0000000000000001')];
+  const g1 = findDuplicateGroups(items);
+  const g2 = findDuplicateGroups([...items].reverse());
+  assert.equal(g1[0].id, g2[0].id);
+  assert.ok(DEFAULT_DUPLICATE_THRESHOLD > 0);
+});
