index 0000000..bcbae93
--- /dev/null
+++ b/src/lib/duplicates.ts
@@ -0,0 +1,89 @@
+import type { Screenshot } from '@/types';
+import type { DuplicateGroup } from '@/duplicate-types';
+// Relative import (not the @/ alias): this module is exercised directly by the
+// plain-Node test runner, which doesn't understand Vite's path alias for
+// runtime (non-type) imports — see tests/duplicates.test.mjs.
+import { hammingDistance } from './phash.ts';
+
+const HASH_LENGTH = 16; // 64-bit dHash, as 16 hex characters
+// Out of 64 bits, empirically <=5 is a re-saved/re-compressed copy of the same
+// image; up to ~10 still reliably catches near-identical screenshots (minor
+// crop, small overlay) without much risk of unrelated images colliding.
+export const DEFAULT_DUPLICATE_THRESHOLD = 8;
+
+function find(parent: Map<string, string>, x: string): string {
+  let root = x;
+  while (parent.get(root) !== root) root = parent.get(root)!;
+  while (parent.get(x) !== root) {
+    const next = parent.get(x)!;
+    parent.set(x, root);
+    x = next;
+  }
+  return root;
+}
+
+function union(parent: Map<string, string>, a: string, b: string): void {
+  const ra = find(parent, a);
+  const rb = find(parent, b);
+  if (ra !== rb) parent.set(ra, rb);
+}
+
+/**
+ * Groups screenshots whose perceptual hashes are within `threshold` bits of
+ * each other (transitively — if A~B and B~C, all three land in one group).
+ * O(n^2) hash comparisons, which is cheap (a XOR + popcount per pair) and
+ * fine for a personal screenshot library; if this ever needs to scale to
+ * tens of thousands of images, bucket by a hash prefix first.
+ */
+export function findDuplicateGroups(
+  items: Screenshot[],
+  threshold = DEFAULT_DUPLICATE_THRESHOLD
+): DuplicateGroup[] {
+  const withHash = items.filter((s) => s.phash?.length === HASH_LENGTH);
+  const parent = new Map<string, string>();
+  for (const s of withHash) parent.set(s.id, s.id);
+
+  // Union first; only once every union is applied is find() stable enough to
+  // key a per-cluster maximum, since path compression can move a root mid-loop.
+  const matches: { a: string; b: string; distance: number }[] = [];
+  for (let i = 0; i < withHash.length; i++) {
+    for (let j = i + 1; j < withHash.length; j++) {
+      const a = withHash[i];
+      const b = withHash[j];
+      const distance = hammingDistance(a.phash!, b.phash!);
+      if (distance <= threshold) {
+        union(parent, a.id, b.id);
+        matches.push({ a: a.id, b: b.id, distance });
+      }
+    }
+  }
+
+  const best = new Map<string, number>();
+  for (const m of matches) {
+    const root = find(parent, m.a);
+    best.set(root, Math.max(best.get(root) ?? 0, m.distance));
+  }
+
+  const clusters = new Map<string, string[]>();
+  for (const s of withHash) {
+    const root = find(parent, s.id);
+    const arr = clusters.get(root) ?? [];
+    arr.push(s.id);
+    clusters.set(root, arr);
+  }
+
+  const byId = new Map(items.map((s) => [s.id, s]));
+  const groups: DuplicateGroup[] = [];
+  for (const [root, ids] of clusters) {
+    if (ids.length < 2) continue;
+    const sorted = [...ids].sort((a, b) => (byId.get(b)?.createdAt ?? 0) - (byId.get(a)?.createdAt ?? 0));
+    groups.push({
+      id: `dup:${[...ids].sort().join(',')}`,
+      screenshotIds: sorted,
+      maxDistance: best.get(root) ?? 0,
+    });
+  }
+  return groups.sort(
+    (a, b) => (byId.get(b.screenshotIds[0])?.createdAt ?? 0) - (byId.get(a.screenshotIds[0])?.createdAt ?? 0)
+  );
+}
diff --git a/src/lib/phash.ts b/src/lib/phash.ts
