index 0000000..e5e2598
--- /dev/null
+++ b/src/lib/phash.ts
@@ -0,0 +1,72 @@
+/**
+ * Perceptual "difference hash" (dHash) for near-duplicate detection.
+ *
+ * The image is downscaled to a tiny grayscale grid and encoded as whether
+ * each pixel is brighter than its right-hand neighbor. Visually similar
+ * images (a re-saved copy, a re-compressed JPEG, a screenshot taken twice
+ * seconds apart) produce hashes that differ in only a few bits, so
+ * near-duplicates can be found with a cheap Hamming-distance comparison
+ * instead of comparing full images pixel-by-pixel.
+ *
+ * This intentionally ignores OCR text: two screenshots of the same page
+ * with different annotations drawn on top will still hash as near-identical,
+ * which is what "possible duplicate" should mean here.
+ */
+const HASH_WIDTH = 9; // one extra column so each row yields 8 left/right comparisons
+const HASH_HEIGHT = 8; // 8 rows * 8 comparisons/row = 64 bits total
+
+export async function computeDHash(blob: Blob): Promise<string> {
+  const url = URL.createObjectURL(blob);
+  try {
+    const img = await new Promise<HTMLImageElement>((resolve, reject) => {
+      const i = new Image();
+      i.onload = () => resolve(i);
+      i.onerror = () => reject(new Error('Could not load image for duplicate detection.'));
+      i.src = url;
+    });
+    const canvas = document.createElement('canvas');
+    canvas.width = HASH_WIDTH;
+    canvas.height = HASH_HEIGHT;
+    const ctx = canvas.getContext('2d', { willReadFrequently: true });
+    if (!ctx) throw new Error('Canvas not supported.');
+    ctx.drawImage(img, 0, 0, HASH_WIDTH, HASH_HEIGHT);
+    const { data } = ctx.getImageData(0, 0, HASH_WIDTH, HASH_HEIGHT);
+    const gray: number[] = [];
+    for (let i = 0; i < data.length; i += 4) {
+      gray.push(0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2]);
+    }
+    let bits = '';
+    for (let row = 0; row < HASH_HEIGHT; row++) {
+      for (let col = 0; col < HASH_WIDTH - 1; col++) {
+        const left = gray[row * HASH_WIDTH + col];
+        const right = gray[row * HASH_WIDTH + col + 1];
+        bits += left > right ? '1' : '0';
+      }
+    }
+    return bitsToHex(bits);
+  } finally {
+    URL.revokeObjectURL(url);
+  }
+}
+
+function bitsToHex(bits: string): string {
+  let hex = '';
+  for (let i = 0; i < bits.length; i += 4) {
+    hex += parseInt(bits.slice(i, i + 4).padEnd(4, '0'), 2).toString(16);
+  }
+  return hex;
+}
+
+/** Number of differing bits between two dHash hex strings. Mismatched lengths never compare as similar. */
+export function hammingDistance(hexA: string, hexB: string): number {
+  if (hexA.length !== hexB.length) return Number.MAX_SAFE_INTEGER;
+  let distance = 0;
+  for (let i = 0; i < hexA.length; i++) {
+    let x = parseInt(hexA[i], 16) ^ parseInt(hexB[i], 16);
+    while (x) {
+      distance += x & 1;
+      x >>= 1;
+    }
+  }
+  return distance;
+}
