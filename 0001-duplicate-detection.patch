new file mode 100644
index 0000000..b759a55
--- /dev/null
+++ b/src/lib/duplicate-decisions.ts
@@ -0,0 +1,58 @@
+import type { DuplicateDecision } from '@/duplicate-types';
+
+async function open(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open('snapsort-duplicates', 1);
+    req.onupgradeneeded = () => req.result.createObjectStore('decisions', { keyPath: 'id' });
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+export async function readDuplicateDecisions(): Promise<DuplicateDecision[]> {
+  const db = await open();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('decisions', 'readonly');
+    const req = tx.objectStore('decisions').getAll();
+    tx.oncomplete = () => { db.close(); resolve(req.result); };
+    tx.onabort = () => { db.close(); reject(tx.error ?? new Error('Cannot read duplicate decisions.')); };
+  });
+}
+
+export async function saveDuplicateDecision(decision: DuplicateDecision): Promise<void> {
+  const db = await open();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('decisions', 'readwrite');
+    tx.objectStore('decisions').put(decision);
+    tx.oncomplete = () => { db.close(); resolve(); };
+    tx.onabort = () => { db.close(); reject(tx.error ?? new Error('Cannot save duplicate decision.')); };
+  });
+}
+
+export async function deleteDuplicateDecision(id: string): Promise<void> {
+  const db = await open();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('decisions', 'readwrite');
+    tx.objectStore('decisions').delete(id);
+    tx.oncomplete = () => { db.close(); resolve(); };
+    tx.onabort = () => { db.close(); reject(tx.error ?? new Error('Cannot reset duplicate decision.')); };
+  });
+}
+
+/** Drop decisions for groups that no longer exist in their exact previous form (membership changed). */
+export async function pruneDuplicateDecisions(validIds: string[]): Promise<void> {
+  const db = await open();
+  const valid = new Set(validIds);
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('decisions', 'readwrite');
+    const req = tx.objectStore('decisions').openCursor();
+    req.onsuccess = () => {
+      const cursor = req.result;
+      if (!cursor) return;
+      if (!valid.has((cursor.value as DuplicateDecision).id)) cursor.delete();
+      cursor.continue();
+    };
+    tx.oncomplete = () => { db.close(); resolve(); };
+    tx.onabort = () => { db.close(); reject(tx.error ?? new Error('Cannot clean up duplicate decisions.')); };
+  });
+}
