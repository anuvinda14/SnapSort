+import { useEffect, useMemo, useRef, useState } from 'react';
+import type { Screenshot } from '@/types';
+import type { DuplicateDecision, DuplicateGroup } from '@/duplicate-types';
+import { findDuplicateGroups } from '@/lib/duplicates';
+import {
+  readDuplicateDecisions,
+  saveDuplicateDecision,
+  deleteDuplicateDecision,
+  pruneDuplicateDecisions,
+} from '@/lib/duplicate-decisions';
+
+export type DuplicateGroupWithStatus = DuplicateGroup & { status: 'pending' | 'dismissed' };
+
+/** Pass loaded=false until the parent has finished loading its screenshot database. */
+export function useDuplicates(items: Screenshot[], loaded: boolean) {
+  const [decisions, setDecisions] = useState<DuplicateDecision[]>([]);
+  const [decisionsLoaded, setDecisionsLoaded] = useState(false);
+  const [error, setError] = useState('');
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const lock = useRef(false);
+
+  // Regroup only when identity-relevant fields change — ignore blob/thumbnail/OCR churn.
+  const signature = JSON.stringify(items.map(({ id, createdAt, size, phash }) => ({ id, createdAt, size, phash })));
+  const groups = useMemo(() => findDuplicateGroups(JSON.parse(signature) as Screenshot[]), [signature]);
+
+  useEffect(() => {
+    let active = true;
+    readDuplicateDecisions()
+      .then((values) => { if (active) setDecisions(values); })
+      .catch((e) => { if (active) setError(String(e)); })
+      .finally(() => { if (active) setDecisionsLoaded(true); });
+    return () => { active = false; };
+  }, []);
+
+  useEffect(() => {
+    if (!loaded || !decisionsLoaded) return;
+    let active = true;
+    pruneDuplicateDecisions(groups.map((g) => g.id)).catch((e) => { if (active) setError(String(e)); });
+    return () => { active = false; };
+  }, [loaded, decisionsLoaded, groups]);
+
+  const withStatus: DuplicateGroupWithStatus[] = groups.map((g) => ({
+    ...g,
+    status: decisions.find((d) => d.id === g.id)?.status ?? 'pending',
+  }));
+  const pendingGroups = withStatus.filter((g) => g.status === 'pending');
+
+  async function dismissGroup(id: string): Promise<void> {
+    if (lock.current) throw new Error('Wait for the current action to finish.');
+    if (!loaded || !decisionsLoaded) throw new Error('Wait for the library to finish loading.');
+    lock.current = true;
+    setBusyId(id);
+    setError('');
+    try {
+      const decision: DuplicateDecision = { id, status: 'dismissed', updatedAt: Date.now() };
+      await saveDuplicateDecision(decision);
+      setDecisions((prev) => [...prev.filter((d) => d.id !== id), decision]);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+      throw e;
+    } finally {
+      lock.current = false;
+      setBusyId(null);
+    }
+  }
+
+  async function resetGroup(id: string): Promise<void> {
+    if (lock.current) throw new Error('Wait for the current action to finish.');
+    lock.current = true;
+    setBusyId(id);
+    try {
+      await deleteDuplicateDecision(id);
+      setDecisions((prev) => prev.filter((d) => d.id !== id));
+      setError('');
+    } catch (e) {
+      setError(String(e));
+      throw e;
+    } finally {
+      lock.current = false;
+      setBusyId(null);
+    }
+  }
+
+  return {
+    groups: withStatus,
+    pendingGroups,
+    loading: !loaded || !decisionsLoaded,
+    error,
+    busyId,
+    dismissGroup,
+    resetGroup,
+  };
+}
